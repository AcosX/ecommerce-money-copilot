# 复制为 backend/.env 后填写。不要提交 .env。
EMC_ENV=dev
EMC_PUBLIC_ORIGIN=http://127.0.0.1:8000
EMC_DATABASE_URL=mysql+pymysql://emc:CHANGE_ME@127.0.0.1:3307/emc?charset=utf8mb4
# >= 32 字节随机值，例如 python -c "import secrets; print(secrets.token_urlsafe(48))"
EMC_SESSION_SECRET=CHANGE_ME
EMC_OIDC_ISSUER=https://connect.example.com
EMC_OIDC_CLIENT_ID=ecommerce-money-copilot-dev
EMC_OIDC_CLIENT_SECRET=CHANGE_ME
EMC_OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# 审核员的 Acos Connect sub，逗号分隔
EMC_REVIEWER_SUBS=
EMC_UPLOAD_DIR=var/uploads
EMC_MAX_UPLOAD_BYTES=10485760
EMC_MAX_FILES_PER_SUBMISSION=5
EMC_MAX_BODY_BYTES=262144
EMC_SESSION_IDLE_SECONDS=604800
EMC_SESSION_ABSOLUTE_SECONDS=2592000
# 本地 http://127.0.0.1 开发可设 false；生产必须 true
EMC_COOKIE_SECURE=false
EMC_LOG_LEVEL=INFO

# docker-compose.dev.yml 使用（仅开发容器）
EMC_DEV_DB_ROOT_PASSWORD=CHANGE_ME
EMC_DEV_DB_PASSWORD=CHANGE_ME
EMC_DEV_DB_PORT=3307

# 可选：pytest 使用的数据库连接（账号需能创建 emc_test_* 库）；默认取 EMC_DATABASE_URL
# EMC_TEST_DATABASE_URL=mysql+pymysql://emc:CHANGE_ME@127.0.0.1:3307/emc?charset=utf8mb4

# 魔珐星云 3D 数字人与 AI 大模型网关（#62 小商伴随 Agent 与六关成果审核）
EMC_XINGYUN_APP_ID=4e1fac3dc3b7452d8717032670c9574c
EMC_XINGYUN_APP_SECRET=CHANGE_ME
EMC_XINGYUN_GATEWAY_URL=https://nebula-agent.xingyun3d.com
EMC_XINGYUN_DEFAULT_PRESET=yingyi
GOOGLE_GEMINI_BASE_URL=https://ai.acosx.xyz
GEMINI_API_KEY=CHANGE_ME
EMC_AI_MODEL=gemini-2.5-flash
EMC_AI_REVIEW_MODEL=gemini-2.5-flash
EMC_AI_TIMEOUT_SECONDS=20

